# Development only; use COOKIE_SECURE=true and HTTPS in production.
APP_ENV=development
COOKIE_SECURE=false
AUTO_MIGRATE=true
# Optional local SQLite fallback uses a NEW backend/data/saas.sqlite3.
# Set this URL to use the Compose PostgreSQL service; configure its password separately.
# DATABASE_URL=postgresql+psycopg://smartanalytics:YOUR_PASSWORD@127.0.0.1:5433/smartanalytics
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6380/0
SMARTANALYTICS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional estimates using the provider rates you have verified for your configured model.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=1800
# Process-local serialized profile cache. No DataFrame is retained.
PROFILE_CACHE_TTL_SECONDS=600
PROFILE_CACHE_MAX_ENTRIES=8
PROFILE_CACHE_MAX_BYTES=8388608
AUTH_LOGIN_LIMIT=10
AI_USER_MINUTE_LIMIT=10
AI_USER_DAILY_LIMIT=100
# All application instances must share this Redis namespace. Isolate QA environments.
RATE_LIMIT_NAMESPACE=smartanalytics
